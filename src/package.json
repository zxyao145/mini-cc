{
  "name": "ome-reader",
  "version": "1.0.0",
  "description": "A read-later application similar to Omnivore",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "concurrently \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "dev:backend": "cd backend/OmeReader.Api && dotnet run",
    "dev:frontend": "cd frontend && pnpm dev",
    "build": "pnpm build:frontend",
    "build:frontend": "cd frontend && pnpm build",
    "build:backend": "cd backend/OmeReader.Api && dotnet build",
    "start:frontend": "cd frontend && pnpm start",
    "install:all": "pnpm install && cd frontend && pnpm install",
    "lint": "cd frontend && pnpm lint",
    "db:migrate": "cd backend/OmeReader.Api && dotnet ef database update",
    "db:migration": "cd backend/OmeReader.Api && dotnet ef migrations add"
  },
  "keywords": [
    "read-later",
    "omnivore",
    "aspnet-core",
    "nextjs",
    "typescript",
    "postgresql"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^7.6.0"
  }
}