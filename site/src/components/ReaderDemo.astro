---
// A static excerpt styled like the MiniCC reader. On load, the highlight sweeps
// across one sentence and its note appears; reduced motion shows the end state.
import '@fontsource-variable/source-serif-4';
import { homeContent, homeLang } from './home-content';

interface Props {
	lang: string;
}

const t = homeContent[homeLang(Astro.props.lang)].demo;
---

<figure class="demo" aria-label={t.label}>
	<div class="progress" aria-hidden="true"><span></span></div>
	<div class="meta">
		<span>{t.source}</span>
		<span>{t.readTime}</span>
	</div>
	<p class="title">{t.title}</p>
	<div class="body">
		<p>{t.before}</p>
		<p><mark>{t.highlight}</mark></p>
		<aside class="note">
			<span class="note-label">{t.noteLabel}</span>
			{t.note}
		</aside>
		<p>{t.after}</p>
	</div>
	<ul class="tags">
		{
			t.tags.map((tag) => (
				<li style={`--tag: ${tag.color}`}>
					<span class="dot" aria-hidden="true" />
					{tag.name}
				</li>
			))
		}
	</ul>
</figure>

<style>
	.demo {
		position: relative;
		margin: 0;
		padding: 1.75rem 1.75rem 1.5rem;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--mc-ink) 14%, transparent);
		border-radius: 0.875rem;
		background: var(--mc-paper);
		box-shadow: 0 28px 56px -32px rgb(0 0 0 / 0.28);
	}

	.progress {
		position: absolute;
		inset: 0 0 auto;
		height: 3px;
		background: color-mix(in srgb, var(--mc-ink) 8%, transparent);
	}

	.progress span {
		display: block;
		width: 38%;
		height: 100%;
		background: var(--mc-ink);
	}

	.meta {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		color: var(--sl-color-gray-3);
		font-size: 0.8125rem;
	}

	.title {
		margin: 0.875rem 0 1rem;
		color: var(--sl-color-white);
		font-size: 1.375rem;
		font-weight: 600;
		line-height: 1.3;
		letter-spacing: var(--mc-heading-tracking, -0.015em);
	}

	.body p {
		margin: 0 0 0.9em;
		color: var(--sl-color-gray-2);
		font-family: 'Source Serif 4 Variable', var(--mc-cjk-serif), serif;
		font-size: 1.0625rem;
		line-height: 1.85;
	}

	mark {
		padding-block: 0.1em;
		background-color: transparent;
		background-image: linear-gradient(var(--mc-mark), var(--mc-mark));
		background-repeat: no-repeat;
		background-size: 100% 100%;
		color: var(--sl-color-white);
	}

	.note {
		margin: -0.25rem 0 1rem 1.25rem;
		padding: 0.625rem 0.875rem;
		border-left: 3px solid var(--mc-highlight);
		border-radius: 0 0.5rem 0.5rem 0;
		background: color-mix(in srgb, var(--mc-ink) 5%, var(--mc-paper));
		color: var(--sl-color-gray-1);
		font-size: 0.875rem;
		line-height: 1.5;
	}

	.note-label {
		display: block;
		margin-bottom: 0.125rem;
		color: var(--sl-color-gray-3);
		font-size: 0.75rem;
		font-weight: 600;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1.25rem 0 0;
		padding: 0;
		list-style: none;
	}

	.tags li {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.2rem 0.65rem;
		border: 1px solid color-mix(in srgb, var(--mc-ink) 14%, transparent);
		border-radius: 999px;
		color: var(--sl-color-gray-2);
		font-size: 0.8125rem;
	}

	.dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--tag);
	}

	@media (prefers-reduced-motion: no-preference) {
		/* Without box-decoration-break: clone, the sweep runs line by line. */
		mark {
			background-size: 0% 100%;
			animation: mc-sweep 1.1s cubic-bezier(0.3, 0.7, 0.2, 1) 0.6s forwards;
		}

		.note {
			opacity: 0;
			transform: translateY(6px);
			animation: mc-note 0.4s ease-out 1.75s forwards;
		}
	}

	@keyframes mc-sweep {
		to {
			background-size: 100% 100%;
		}
	}

	@keyframes mc-note {
		to {
			opacity: 1;
			transform: none;
		}
	}

	@media (max-width: 30rem) {
		.demo {
			padding: 1.5rem 1.25rem 1.25rem;
		}
	}
</style>
